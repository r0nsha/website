---
const hasHaiku = Astro.slots.has("haiku");
---

<section class="container">
    <slot name="text" />
    {
        hasHaiku && (
            <section class="haiku">
                <span class="quote">“</span>
                <slot name="haiku" />
                <span class="quote">”</span>
            </section>
        )
    }
</section>

<style>
    .container {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 1rem;

        p {
            margin: 0;

            &:empty {
                display: none;
            }
        }
    }

    .haiku {
        height: min-content;
        padding-block: 1rem;
        display: flex;
        justify-content: center;
        gap: 0.25rem;
        font-size: 1.15rem;
        font-weight: bold;
        color: var(--g4);
        white-space: pre;
    }

    .quote {
        content: "”";
        font-size: 2rem;
        color: var(--g3);

        &:last-child {
            transform: translateY(1rem);
            align-self: flex-end;
        }
    }

    @media (max-width: 920px) {
        .container {
            flex-direction: column;
            gap: 0.5rem;
        }
    }
</style>
